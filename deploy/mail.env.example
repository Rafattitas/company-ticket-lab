# Copy to /etc/company-ticket/mail.env (production) or .env.mail (quickstart).
# Use chmod 0600, root ownership in production; this file contains a credential.
SMTP_ENABLED=true
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_FROM=support@example.com
SMTP_USER=support@example.com
SMTP_PASSWORD=replace-with-smtp-credential
PUBLIC_APP_URL=https://tickets.example.com
# Port 465 uses implicit TLS; all other ports require STARTTLS.
# PUBLIC_APP_URL is an origin only; private tokens never enter notifications.
