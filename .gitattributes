* text=auto

# Files executed or parsed on Linux must keep Unix line endings when contributors
# work from Windows.
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
Dockerfile text eol=lf

# Keep repository documentation and configuration diffs consistent.
*.md text eol=lf
*.json text eol=lf
*.sql text eol=lf
